{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Rempart",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "fr",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["declarativeNetRequest", "storage", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "safety", "enabled": true, "path": "rules/safety.json" },
      { "id": "blocklist", "enabled": true, "path": "rules/blocklist.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-guard.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["content/reddit.js"],
      "css": ["content/reddit.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "js": ["content/x-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["pages/blocked.html", "pages/filtered.html"], "matches": ["<all_urls>"] }
  ],
  "action": { "default_popup": "popup/popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_ui": { "page": "pages/options.html", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": { "id": "rempart@rempart-bloqueur", "strict_min_version": "128.0" }
  }
}
